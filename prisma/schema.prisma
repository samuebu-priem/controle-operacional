generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String
  fullName            String?
  jobTitle            String?
  email               String                @unique
  password            String
  role                String                @default("INSPETOR")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  inspecoes           Inspecao[]
  patioAllocationsRegistered PatioAllocation[] @relation("PatioAllocationRegisteredBy")
  patioAllocationsReleased   PatioAllocation[] @relation("PatioAllocationReleasedBy")

  @@index([role])
}

model Frota {
  id                  String                @id @default(cuid())
  numeroFrota         String                @unique
  placa               String
  tipoEquipamento     String
  material            String
  capacidade          String
  observacoesFixas    String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  inspecoes           Inspecao[]
  patioAllocations    PatioAllocation[]

  @@index([numeroFrota])
  @@index([placa])
}

model Patio {
  id        String      @id @default(cuid())
  branch    String
  nome      String
  ordem     Int         @default(0)
  ativo     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  areas     PatioArea[]

  @@unique([branch, nome])
  @@index([branch, ativo, ordem])
}

model PatioArea {
  id          String             @id @default(cuid())
  patioId     String
  nome        String
  capacidade Int
  ordem       Int                @default(0)
  x           Float
  y           Float
  cor         String             @default("#22c55e")
  ativo       Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  patio       Patio              @relation(fields: [patioId], references: [id], onDelete: Cascade)
  allocations PatioAllocation[]

  @@unique([patioId, nome])
  @@index([patioId, ativo, ordem])
}

model PatioAllocation {
  id             String    @id @default(cuid())
  fleetId        String
  areaId         String
  branch         String
  origin         PatioAllocationOrigin @default(MANUAL_ALLOCATION)
  releaseOrigin  PatioAllocationOrigin?
  registeredById String
  releasedById   String?
  registeredAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  releasedAt     DateTime?
  note           String?
  releaseNote    String?
  fleet          Frota     @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  area           PatioArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  registeredBy   User      @relation("PatioAllocationRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  releasedBy     User?     @relation("PatioAllocationReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@index([areaId, releasedAt, createdAt])
  @@index([fleetId, branch, releasedAt, createdAt])
  @@index([branch, updatedAt])
  @@index([registeredById])
  @@index([releasedById])
}

enum PatioAllocationOrigin {
  INITIAL_INVENTORY
  MANUAL_ALLOCATION
  MANUAL_MOVE
  MANUAL_RELEASE
}

model Collaborator {
  id        String     @id @default(cuid())
  nome      String
  ativo     Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  inspecoes Inspecao[]

  @@index([nome])
  @@index([ativo])
}

model Inspecao {
  id                    String                 @id @default(cuid())
  frotaId               String
  userId                String?
  colaboradorId         String?
  dataInspecao          DateTime
  tipoInspecao          TipoInspecao
  status                StatusInspecao
  resultadoPosLavagem   ResultadoPosLavagem?
  motivoNaoConformidade MotivoNaoConformidade?
  observacoesGerais     String?
  nomeInspetor          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  fotos                 FotoInspecao[]
  colaborador           Collaborator?          @relation(fields: [colaboradorId], references: [id])
  frota                 Frota                  @relation(fields: [frotaId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id])
  pontosCriticos        PontoCritico[]

  @@index([frotaId, dataInspecao])
  @@index([colaboradorId, dataInspecao])
  @@index([tipoInspecao])
  @@index([status])
  @@index([resultadoPosLavagem])
  @@index([motivoNaoConformidade])
}

model PontoCritico {
  id                      String         @id @default(cuid())
  inspecaoId              String
  categoria               String
  localizacao             String
  descricao               String
  severidade              Severidade
  createdAt               DateTime       @default(now())
  procedimentoRecomendado String
  fotos                   FotoInspecao[]
  inspecao                Inspecao       @relation(fields: [inspecaoId], references: [id], onDelete: Cascade)

  @@index([inspecaoId])
  @@index([categoria])
  @@index([localizacao])
}

model FotoInspecao {
  id             String        @id @default(cuid())
  inspecaoId     String
  pontoCriticoId String?
  imageUrl       String
  fileName       String
  legenda        String?
  createdAt      DateTime      @default(now())
  inspecao       Inspecao      @relation(fields: [inspecaoId], references: [id], onDelete: Cascade)
  pontoCritico   PontoCritico? @relation(fields: [pontoCriticoId], references: [id])

  @@index([inspecaoId])
  @@index([pontoCriticoId])
}

enum TipoInspecao {
  ANTES_LAVAGEM
  APOS_LAVAGEM
}

enum StatusInspecao {
  APROVADO
  REPROVADO
  COM_OBSERVACAO
}

enum Severidade {
  LEVE
  MEDIA
  GRAVE
}

enum ResultadoPosLavagem {
  APROVADO
  REPROVADO
}

enum MotivoNaoConformidade {
  FERRUGEM
  MANCHA
  AMARELAMENTO
  ODOR
  PRODUTO_RESIDUAL
  VALVULA_CONTAMINADA
  OUTRO
}
