generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String
  fullName            String?
  jobTitle            String?
  email               String                @unique
  password            String
  role                String                @default("INSPETOR")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  inspecoes           Inspecao[]
  yardLocations       YardLocation[]
  yardLocationHistory YardLocationHistory[]

  @@index([role])
}

model Frota {
  id                  String                @id @default(cuid())
  numeroFrota         String                @unique
  placa               String
  tipoEquipamento     String
  material            String
  capacidade          String
  observacoesFixas    String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  inspecoes           Inspecao[]
  yardLocations       YardLocation[]
  yardLocationHistory YardLocationHistory[]

  @@index([numeroFrota])
  @@index([placa])
}

model YardLocation {
  id          String               @id @default(cuid())
  fleetId     String
  branch      YardBranch
  xPercent    Float
  yPercent    Float
  note        String?
  sector      YardSector?
  accuracy    YardLocationAccuracy
  source      YardLocationSource   @default(MANUAL)
  updatedById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  fleet       Frota                @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  updatedBy   User                 @relation(fields: [updatedById], references: [id])

  @@unique([fleetId, branch])
  @@index([branch, updatedAt])
  @@index([branch, sector, updatedAt])
  @@index([updatedById])
}

model YardLocationHistory {
  id          String               @id @default(cuid())
  fleetId     String
  branch      YardBranch
  xPercent    Float
  yPercent    Float
  note        String?
  sector      YardSector?
  accuracy    YardLocationAccuracy
  source      YardLocationSource   @default(MANUAL)
  updatedById String
  createdAt   DateTime             @default(now())
  fleet       Frota                @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  updatedBy   User                 @relation(fields: [updatedById], references: [id])

  @@index([fleetId, branch, createdAt])
  @@index([branch, createdAt])
  @@index([branch, sector, createdAt])
  @@index([updatedById])
}

model Collaborator {
  id        String     @id @default(cuid())
  nome      String
  ativo     Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  inspecoes Inspecao[]

  @@index([nome])
  @@index([ativo])
}

model Inspecao {
  id                    String                 @id @default(cuid())
  frotaId               String
  userId                String?
  colaboradorId         String?
  dataInspecao          DateTime
  tipoInspecao          TipoInspecao
  status                StatusInspecao
  resultadoPosLavagem   ResultadoPosLavagem?
  motivoNaoConformidade MotivoNaoConformidade?
  observacoesGerais     String?
  nomeInspetor          String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  fotos                 FotoInspecao[]
  colaborador           Collaborator?          @relation(fields: [colaboradorId], references: [id])
  frota                 Frota                  @relation(fields: [frotaId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id])
  pontosCriticos        PontoCritico[]

  @@index([frotaId, dataInspecao])
  @@index([colaboradorId, dataInspecao])
  @@index([tipoInspecao])
  @@index([status])
  @@index([resultadoPosLavagem])
  @@index([motivoNaoConformidade])
}

model PontoCritico {
  id                      String         @id @default(cuid())
  inspecaoId              String
  categoria               String
  localizacao             String
  descricao               String
  severidade              Severidade
  createdAt               DateTime       @default(now())
  procedimentoRecomendado String
  fotos                   FotoInspecao[]
  inspecao                Inspecao       @relation(fields: [inspecaoId], references: [id], onDelete: Cascade)

  @@index([inspecaoId])
  @@index([categoria])
  @@index([localizacao])
}

model FotoInspecao {
  id             String        @id @default(cuid())
  inspecaoId     String
  pontoCriticoId String?
  imageUrl       String
  fileName       String
  legenda        String?
  createdAt      DateTime      @default(now())
  inspecao       Inspecao      @relation(fields: [inspecaoId], references: [id], onDelete: Cascade)
  pontoCritico   PontoCritico? @relation(fields: [pontoCriticoId], references: [id])

  @@index([inspecaoId])
  @@index([pontoCriticoId])
}

enum TipoInspecao {
  ANTES_LAVAGEM
  APOS_LAVAGEM
}

enum StatusInspecao {
  APROVADO
  REPROVADO
  COM_OBSERVACAO
}

enum Severidade {
  LEVE
  MEDIA
  GRAVE
}

enum ResultadoPosLavagem {
  APROVADO
  REPROVADO
}

enum MotivoNaoConformidade {
  FERRUGEM
  MANCHA
  AMARELAMENTO
  ODOR
  PRODUTO_RESIDUAL
  VALVULA_CONTAMINADA
  OUTRO
}

enum YardBranch {
  PAULINIA
}

enum YardLocationAccuracy {
  EXACT
  APPROXIMATE
}

enum YardLocationSource {
  MANUAL
  OCR
}

enum YardSector {
  A
  B
  C
  D
  E
  F
  G
  H
}
